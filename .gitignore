# .gitignore — MyPersonalAI

# Secrets — NEVER commit these
.env
*.env
.env.local
.env.production

# Large AI model files
ai/models/**/*.bin
ai/models/**/*.gguf
ai/models/**/*.safetensors

# Node.js
node_modules/
frontend/node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
frontend/dist/
frontend/build/
backend/dist/

# Logs
logs/*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# VS Code (optional — keep if you want to share workspace settings)
# .vscode/

# RAG vector index (regenerated automatically)
knowledge/rag_index/

# Temporary files
*.tmp
*.temp

ai/models/blobs/
