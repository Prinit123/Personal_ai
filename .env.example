# ===================================================================
# MyPersonalAI (Nilesh AI) — Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit your real .env file with secrets to Git.
# ===================================================================

# ─── Server & Network Configuration ───────────────────────────────
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# ─── AI Model Provider Configuration ──────────────────────────────
# Supported providers: "gemini" | "groq" | "openai" | "openrouter" | "ollama"
# Recommendation: "gemini" for fast, reliable online AI with low memory footprint
AI_PROVIDER=gemini

# Default model name
# Examples:
#   Google Gemini: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
#   Groq:          llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b
#   OpenAI:        gpt-4o-mini, gpt-4o
#   Ollama Local:  qwen2.5-coder:3b, qwen2.5-coder:1.5b
AI_MODEL=gemini-2.5-flash

# API Key for chosen provider (leave blank if using local Ollama)
# Get a free Gemini API key: https://aistudio.google.com/app/apikey
# Get a free Groq API key:   https://console.groq.com/keys
AI_API_KEY=

# Base URL (optional, for custom/OpenAI-compatible or local inference endpoints)
# Examples:
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   LM Studio:  http://localhost:1234/v1
AI_BASE_URL=

# ─── Legacy / Compatibility Keys ──────────────────────────────────
# Maintained for backward compatibility with earlier versions
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:3b

# Optional Brave Search API Key for web research (2,000 free queries/mo)
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# ─── Storage Directories (Relative for USB Portability) ────────────
DATA_DIR=data
PROJECTS_DIR=projects
